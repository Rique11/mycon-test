# Gateway (copie para gateway/.env)
PORT=3001
SPRING_BACKEND_URL=http://localhost:8083
CORS_ORIGINS=http://localhost:5173

# Mesmo project_id usado pelo frontend.
FIREBASE_PROJECT_ID=

# Credencial recomendada:
# defina GOOGLE_APPLICATION_CREDENTIALS com o caminho absoluto do JSON da
# service account. Em Google Cloud, Application Default Credentials é usada.
GOOGLE_APPLICATION_CREDENTIALS=

# Claim customizada que identifica o tenant. Se o Firebase Authentication
# multi-tenancy estiver ativo, firebase.tenant também é aceito.
FIREBASE_TENANT_CLAIM=tenant_id
REQUIRE_TENANT=true
VERIFY_REVOKED_TOKENS=true

# forward-firebase | service-token | none
UPSTREAM_AUTH_MODE=forward-firebase
UPSTREAM_SERVICE_TOKEN=

# Opcional, mas recomendado: assina os headers de identidade enviados ao Spring.
GATEWAY_SHARED_SECRET=
PROXY_TIMEOUT_MS=30000
