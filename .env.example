# Frontend (copie para .env.local)
# O navegador chama somente o gateway Node, nunca o Spring diretamente.
VITE_API_URL=http://localhost:3001

# Configuração pública do app Web criado no Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: use quando o projeto utiliza Firebase Authentication multi-tenancy.
VITE_FIREBASE_TENANT_ID=

# Tenant de negócio solicitado pela aplicação. O gateway compara este valor com
# a claim assinada no token. Se omitido, usa VITE_FIREBASE_TENANT_ID.
VITE_TENANT_ID=
