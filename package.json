{
  "name": "mycon-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:gateway": "npm run dev --prefix gateway",
    "build": "vite build",
    "build:gateway": "npm run build --prefix gateway",
    "build:all": "npm run build && npm run build:gateway",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:gateway": "npm run typecheck --prefix gateway",
    "test": "vitest run",
    "test:gateway": "npm test --prefix gateway"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "^11.1.1"
  }
}
